#!/bin/sh
STATE_DIR="/tmp/tmux-claude-$(id -u)"
[ -n "$TMUX_PANE" ] || exit 0
mkdir -p "$STATE_DIR"
"$(dirname "$0")/tmux-claude-ensure-tmux"
date +%s > "$STATE_DIR/${TMUX_PANE}.waiting"

# Ring the bell on the waiting pane's terminal so tmux flags its window
# (monitor-bell -> window-status-bell-style). Hooks run without a controlling
# terminal, so /dev/tty does not exist for them; resolve the pane's real tty via
# tmux and write the BEL there instead.
PANE_TTY=$(tmux display-message -p -t "$TMUX_PANE" '#{pane_tty}' 2>/dev/null)
if [ -n "$PANE_TTY" ] && [ -w "$PANE_TTY" ]; then
    printf '\a' > "$PANE_TTY" 2>/dev/null
fi

# Never let a failed bell turn into noisy hook feedback.
exit 0
