#!/usr/bin/env python3
"""Install or remove tmux-agent entries in Claude Code and Codex hook files."""

import json
import os
import shlex
import sys
import tempfile
from pathlib import Path


PREFIXES = ("tmux-agent-", "tmux-claude-", "tmux-codex-")


def is_ours(handler: object) -> bool:
    if not isinstance(handler, dict):
        return False
    command = str(handler.get("command", ""))
    return any(prefix in command for prefix in PREFIXES)


def remove_ours(hooks: object) -> dict[str, list[dict]]:
    if not isinstance(hooks, dict):
        return {}

    cleaned: dict[str, list[dict]] = {}
    for event, groups in hooks.items():
        if not isinstance(groups, list):
            continue
        kept_groups = []
        for group in groups:
            if not isinstance(group, dict):
                continue
            handlers = group.get("hooks", [])
            if not isinstance(handlers, list):
                kept_groups.append(group)
                continue
            kept_handlers = [handler for handler in handlers if not is_ours(handler)]
            if kept_handlers:
                kept_group = dict(group)
                kept_group["hooks"] = kept_handlers
                kept_groups.append(kept_group)
        if kept_groups:
            cleaned[event] = kept_groups
    return cleaned


def hook(bin_dir: Path, script: str, agent: str, timeout: bool = False) -> dict:
    handler = {
        "type": "command",
        "command": f"{shlex.quote(str(bin_dir / script))} {agent}",
    }
    if timeout:
        handler["timeout"] = 5
    return {"hooks": [handler]}


def install(hooks: dict[str, list[dict]], product: str, bin_dir: Path) -> None:
    if product == "claude":
        for event in ("Stop", "Notification", "PermissionRequest"):
            hooks.setdefault(event, []).append(
                {"matcher": "", **hook(bin_dir, "tmux-agent-notify", product)}
            )
        hooks.setdefault("PreToolUse", []).append(
            {
                "matcher": "AskUserQuestion",
                **hook(bin_dir, "tmux-agent-notify", product),
            }
        )
        hooks.setdefault("UserPromptSubmit", []).append(
            {"matcher": "", **hook(bin_dir, "tmux-agent-resume", product)}
        )
        hooks.setdefault("SessionEnd", []).append(
            {"matcher": "", **hook(bin_dir, "tmux-agent-cleanup", product)}
        )
    else:
        for event in ("Stop", "PermissionRequest"):
            hooks.setdefault(event, []).append(
                hook(bin_dir, "tmux-agent-notify", product, timeout=True)
            )
        hooks.setdefault("UserPromptSubmit", []).append(
            hook(bin_dir, "tmux-agent-resume", product, timeout=True)
        )


def write_json(path: Path, data: dict) -> None:
    with tempfile.NamedTemporaryFile(
        mode="w", encoding="utf-8", dir=path.parent, delete=False
    ) as output:
        json.dump(data, output, indent=2)
        output.write("\n")
        temp_path = Path(output.name)
    os.replace(temp_path, path)


def main() -> int:
    if (
        len(sys.argv) != 5
        or sys.argv[1] not in {"install", "uninstall"}
        or sys.argv[2] not in {"claude", "codex"}
    ):
        print(
            "usage: tmux-agent-hooks install|uninstall claude|codex CONFIG_FILE BIN_DIR",
            file=sys.stderr,
        )
        return 2

    action, product = sys.argv[1:3]
    path = Path(sys.argv[3]).expanduser()
    bin_dir = Path(sys.argv[4]).resolve()

    if action == "install" and not path.parent.is_dir():
        print(
            f"Could not update {path}: config directory does not exist: {path.parent}",
            file=sys.stderr,
        )
        return 1

    if path.exists():
        try:
            with path.open(encoding="utf-8") as source:
                config = json.load(source)
        except (OSError, json.JSONDecodeError) as error:
            print(f"Could not read {path}: {error}", file=sys.stderr)
            return 1
        if not isinstance(config, dict):
            print(f"Could not update {path}: top-level JSON must be an object", file=sys.stderr)
            return 1
    else:
        if action == "uninstall":
            return 0
        config = {}

    hooks = remove_ours(config.get("hooks", {}))
    if action == "install":
        install(hooks, product, bin_dir)

    if hooks:
        config["hooks"] = hooks
    else:
        config.pop("hooks", None)
    write_json(path, config)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
