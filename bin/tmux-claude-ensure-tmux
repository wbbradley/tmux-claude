#!/bin/sh
# Idempotently configure tmux integration (status bar, keybinding, focus hooks).
# Called lazily by hook scripts — safe to run repeatedly, fast no-op after first run.
#
# Robust against where it's invoked from: every option we set is server-global
# (-g), so we do NOT need to be attached to a tmux client or have $TMUX set. We
# only require that a tmux server is already running, and we configure that
# server directly. When no server is running we exit quietly (we never start
# one), so Claude Code outside tmux stays a silent no-op.

# tmux must be installed.
command -v tmux >/dev/null 2>&1 || exit 0

# A server must already be running. `list-sessions` reports this without
# starting a server (unlike many other tmux subcommands). If $TMUX is set the
# tmux commands below automatically target that server; otherwise they target
# the default socket's server.
tmux list-sessions >/dev/null 2>&1 || exit 0

BIN_DIR="$(cd "$(dirname "$0")" && pwd)"

# Status bar: prepend our segment so any user-defined static content
# (e.g. hostname) stays on the far right.
CURRENT_SR=$(tmux show-option -gv status-right 2>/dev/null || echo "")
if ! echo "$CURRENT_SR" | grep -q "tmux-claude-status"; then
    if [ -n "$CURRENT_SR" ]; then
        tmux set-option -g status-right "#($BIN_DIR/tmux-claude-status) $CURRENT_SR"
    else
        tmux set-option -g status-right "#($BIN_DIR/tmux-claude-status)"
    fi
fi

# Status bar length
CURRENT_LEN=$(tmux show-option -gv status-right-length 2>/dev/null || echo "40")
if [ "$CURRENT_LEN" -lt 80 ] 2>/dev/null; then
    tmux set-option -g status-right-length 80
fi

# Keybinding (bind-key is idempotent — overwrites any prior binding)
tmux bind-key g run-shell "$BIN_DIR/tmux-claude-jump"

# Focus hooks
if ! tmux show-hooks -g 2>/dev/null | grep -q "tmux-claude-focus"; then
    tmux set-hook -ga after-select-pane "run-shell \"$BIN_DIR/tmux-claude-focus '#{pane_id}'\""
    tmux set-hook -ga after-select-window "run-shell \"$BIN_DIR/tmux-claude-focus '#{pane_id}'\""
fi
